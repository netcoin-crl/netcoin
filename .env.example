# NetCoin local/testnet environment example. Copy to .env locally; never commit real secrets.

# Faucet listener
NETCOIN_FAUCET_HOST=127.0.0.1
NETCOIN_FAUCET_PORT=8081
NETCOIN_FAUCET_AMOUNT=5
NETCOIN_FAUCET_FEE=0.01
NETCOIN_FAUCET_COOLDOWN_SECONDS=3600
NETCOIN_FAUCET_ADDRESS_COOLDOWN_SECONDS=3600
NETCOIN_FAUCET_MAX_PER_MINUTE=5
NETCOIN_FAUCET_DAILY_CAP_SATS=0

# Faucet proof-of-work escalation. Use a long random secret in production.
NETCOIN_FAUCET_POW_DIFFICULTY=0
NETCOIN_FAUCET_POW_SECRET=replace-with-long-random-local-secret
NETCOIN_FAUCET_POW_TTL=300

# Faucet CAPTCHA provider. Supported: none, simple, turnstile, hcaptcha.
# Do not commit real site keys or secrets. Configure these in the host secret manager/systemd drop-in.
NETCOIN_FAUCET_CAPTCHA_PROVIDER=none
NETCOIN_FAUCET_CAPTCHA_SITEKEY=replace-with-provider-site-key
NETCOIN_FAUCET_CAPTCHA_SECRET=replace-with-provider-secret
# Optional override for tests/private gateways; leave blank for provider default.
NETCOIN_FAUCET_CAPTCHA_VERIFY_URL=

# Operator-only admin API. Never commit a real token.
NETCOIN_FAUCET_ADMIN_TOKEN=replace-with-long-random-admin-token
