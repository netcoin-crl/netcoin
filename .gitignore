# Local runtime JSON only. Do not ignore all *.json:
# architecture manifests, fixtures, package-lock files, OpenAPI artifacts,
# reports, and static API fallbacks must remain visible to git and CI.
wallet.json
wallet-*.json
node-state.json
peers.json
mempool.json
chainstate.json
local-*.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# JS deps and Rust build output
node_modules/
target/
