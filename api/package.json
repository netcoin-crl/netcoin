{
  "name": "@netcoin/api",
  "private": true,
  "version": "0.42.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "parity": "npm run build && node dist/run-parity.js",
    "test": "node --test",
    "start": "node dist/server.js",
    "contract": "npm run build && node -e \"import('./dist/openapi-enforce.js').then(m=>console.log(JSON.stringify(m.assertOpenApiContract(), null, 2)))\"",
    "ci:api": "npm run build && npm run contract && npm run parity"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "fastify": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest"
  }
}
