# Netcoin deployment environment template.
# Copy to deploy/deploy.env and fill in real values. Do not commit secrets.

# AWS profile/region. Leave AWS_PROFILE empty to use default AWS credential chain.
AWS_PROFILE=
AWS_REGION=us-east-1

# Static-site buckets. Use bucket names only, not s3:// prefixes.
NETCOIN_WALLET_BUCKET=wallet.netcoin.online
NETCOIN_EXPLORER_BUCKET=explorer.netcoin.online
NETCOIN_PAY_BUCKET=pay.netcoin.online
NETCOIN_MERCHANT_BUCKET=merchant.netcoin.online
NETCOIN_FAUCET_BUCKET=faucet.netcoin.online
NETCOIN_STATUS_BUCKET=status.netcoin.online
NETCOIN_COMMUNITY_BUCKET=community.netcoin.online
NETCOIN_MARKETS_BUCKET=markets.netcoin.online
NETCOIN_DOCS_BUCKET=docs.netcoin.online
NETCOIN_API_BUCKET=api.netcoin.online

# Optional CloudFront distribution IDs. Leave blank to skip invalidation.
NETCOIN_WALLET_CF=
NETCOIN_EXPLORER_CF=
NETCOIN_PAY_CF=
NETCOIN_MERCHANT_CF=
NETCOIN_FAUCET_CF=
NETCOIN_STATUS_CF=
NETCOIN_COMMUNITY_CF=
NETCOIN_MARKETS_CF=
NETCOIN_DOCS_CF=
NETCOIN_API_CF=

# Node rollout.
NETCOIN_NODES_FILE=deploy/nodes.txt
NETCOIN_RELEASE_ZIP=../netcoin-main-wallet-modes-site-split.zip
NETCOIN_REMOTE_RELEASE=/tmp/netcoin-release.zip
NETCOIN_REMOTE_DEPLOY=/tmp/netcoin-deploy-seed.sh
NETCOIN_SSH_USER=ubuntu
NETCOIN_SSH_KEY=
NETCOIN_DEPLOY_SERVICE=netcoin-node.service
NETCOIN_DEPLOY_PORT=28444

# GitHub push.
# Example: https://github.com/Adoniyas1/netcoin-main.git
NETCOIN_GITHUB_REMOTE=
NETCOIN_GITHUB_BRANCH=v1-wallet-modes-site-split
NETCOIN_GITHUB_BASE=main
